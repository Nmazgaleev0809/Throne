# --- Chain ---
RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
CHAIN_ID=8453
CONTRACT_ADDRESS=0xYourDeployedThroneContract
START_BLOCK=0              # REQUIRED: the block the contract was deployed in
CONFIRMATIONS=2

# --- Moderator hot key (can only approve/reject; keep a little ETH on it for gas) ---
MODERATOR_PRIVATE_KEY=0x...

# --- Telegram moderation ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=0   # your numeric Telegram user id

# --- Rules ---
TEXT_AUTO_APPROVE_DELAY=120
ALLOW_LINKS=false
MAX_MESSAGE_CHARS=256
MAX_UPLOAD_BYTES=5242880
MAX_IMAGE_W=1920
MAX_IMAGE_H=1080
UPLOADS_PER_HOUR=20

# --- Misc ---
DATABASE_URL=sqlite:///./throne.db
DATA_DIR=./data
CORS_ORIGINS=*
